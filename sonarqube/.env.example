# ==============================================
# SonarQube Environment Configuration Example
# ==============================================

# SonarQube Image & Port
SONARQUBE_IMAGE=sonarqube:community
SONARQUBE_PORT=9000

# PostgreSQL Database Connection (on shared-net)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sonarqube
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar
